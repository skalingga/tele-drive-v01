# ==========================================
# TeleDrive v1.3 configuration
# Copy to .env and fill in. Never commit .env.
# ==========================================

NODE_ENV=development
PORT=3000

# ---- Telegram application credentials (required) ----
# One app id/hash for the whole server, from https://my.telegram.org → API development tools.
# Users never need their own: each user logs in with their OWN Telegram account via QR code.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Encrypts every user's MTProto session at rest (AES-256-GCM). 32 bytes as 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later logs every user out (their stored sessions become unreadable).
TELEGRAM_SESSION_ENCRYPTION_KEY=

# ---- Storage ----
# telegram = files go to a private "TeleDrive Storage" channel in each user's own account (default)
# local    = development only: file bytes stay on this machine (login is still via Telegram)
STORAGE_MODE=telegram

# Paths are relative to the repository root (not the current working directory).
DATABASE_PATH=data/teledrive.sqlite
UPLOAD_TEMP_DIR=data/tmp/uploads
LOCAL_STORAGE_DIR=data/storage

# Max size per upload in MB (Telegram allows 2000 MB per file for non-Premium accounts).
MAX_UPLOAD_MB=2000

# Extra Telegram connections per user for downloads/video streaming (1-8). Telegram throttles each
# connection to a fraction of your bandwidth, so speed scales ~linearly with this. They are opened on demand
# for larger downloads and closed after 60 s idle. The main connection is kept free for uploads.
DOWNLOAD_CONNECTIONS=4

# ---- HTTP ----
# Cookies are Secure by default in production. Set to false only for plain-HTTP local testing.
# COOKIE_SECURE=true
# Set when running behind a reverse proxy (e.g. "1" or "loopback") so client IPs and HTTPS are detected.
# TRUST_PROXY=1
